{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_summary.schema.json",
  "title": "Adapter run summary",
  "type": "object",
  "required": [
    "total",
    "succeeded",
    "failed",
    "skipped",
    "fallback",
    "started_at",
    "finished_at",
    "duration_seconds",
    "backend",
    "platform",
    "model_revision",
    "output_dir",
    "config_digest"
  ],
  "properties": {
    "total": { "type": "integer", "minimum": 1 },
    "succeeded": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "fallback": { "type": "integer", "minimum": 0 },
    "started_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "finished_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "backend": { "type": "string", "enum": ["transformers", "vllm", "mock"] },
    "platform": { "type": "string" },
    "model_revision": { "type": ["string", "null"] },
    "dataset_revision": { "type": ["string", "null"] },
    "output_dir": { "type": "string" },
    "config_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "model_load_seconds": { "type": ["number", "null"] },
    "pages_missing_records": { "type": "array", "items": { "type": "string" } },
    "output_completeness": {
      "type": "object",
      "properties": {
        "complete": { "type": "boolean" },
        "missing": { "type": "array" },
        "empty": { "type": "array" }
      }
    }
  }
}
